# Copy this file to .env and fill in your own values. Never commit .env.
CANVAS_API_TOKEN=your-canvas-personal-access-token
CANVAS_BASE_URL=https://your-institution.instructure.com

# Fill this in after you publish your own dashboard Artifact (see README step 5) —
# the canvas-sync skill reads it from here instead of anyone hardcoding it.
DASHBOARD_URL=

# Optional: where synced course files land. Defaults to ~/Documents/canvas files if unset.
# COURSE_FILES_ROOT=/Users/you/Documents/canvas files
